PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
PUBLIC_SUPABASE_STORAGE_BUCKET=designs

# Optional: WhatsApp Business number for "Notify by WhatsApp" on order success. International format without + (e.g. 34912345678).
# PUBLIC_WHATSAPP_BUSINESS_PHONE=34912345678

# Server-only: used by /api/upload-design to upload design images (bypasses Storage RLS).
# Get it in Supabase Dashboard → Settings → API → "service_role" (secret). Never expose in client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
