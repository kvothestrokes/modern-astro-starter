---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Panel interno' } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-zinc-100 text-zinc-900">
    <div class="min-h-screen md:grid md:grid-cols-[260px_1fr]">
      <aside class="border-b border-zinc-200 bg-white p-4 md:border-b-0 md:border-r md:border-r-zinc-200">
        <p class="mb-3 text-sm font-semibold text-zinc-900">Panel interno</p>
        <nav class="space-y-1 text-sm text-zinc-600">
          <a href="/admin/pedidos" class="block rounded px-2 py-1 transition-colors hover:bg-zinc-100 hover:text-zinc-900">Pedidos</a>
          <a href="/admin/productos" class="block rounded px-2 py-1 transition-colors hover:bg-zinc-100 hover:text-zinc-900">Productos</a>
          <a href="/admin/productos/carga-csv" class="block rounded px-2 py-1 transition-colors hover:bg-zinc-100 hover:text-zinc-900">Carga CSV</a>
          <a href="/admin/disenos" class="block rounded px-2 py-1 transition-colors hover:bg-zinc-100 hover:text-zinc-900">Diseños</a>
          <a href="/admin/collage" class="block rounded px-2 py-1 transition-colors hover:bg-zinc-100 hover:text-zinc-900">Collage</a>
        </nav>
      </aside>
      <main class="p-4 md:p-6">
        <slot />
      </main>
    </div>
  </body>
</html>
