---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle = '' } = Astro.props;
---

<div class="mb-4 border-b border-sky-200 pb-3">
  <h1 class="text-xl font-semibold tracking-tight text-zinc-900 md:text-2xl">{title}</h1>
  {subtitle && <p class="mt-1 text-sm text-zinc-600">{subtitle}</p>}
</div>
