---
import type { ColorOption } from '../../lib/productOptions';

interface Props {
  colors: ColorOption[];
  name?: string;
  containerId?: string;
  inputId?: string;
  defaultValue?: string;
  label?: string;
}

const { colors, name = 'color', containerId, inputId, defaultValue = 'Negro', label = 'Color' } = Astro.props;
---

<div class="grid gap-1 text-sm">
  {label ? (
    <span class="font-medium">{label}</span>
  ) : null}
  <div
    class="color-swatches mt-1 flex flex-wrap gap-2"
    id={containerId}
    role="group"
    aria-label="Color"
  >
    {colors.map((c) => (
      <button
        type="button"
        class={`color-swatch h-8 w-8 rounded-full border-2 border-zinc-300 transition focus:outline-none focus:ring-2 focus:ring-zinc-900 data-[selected=true]:border-zinc-900 data-[selected=true]:ring-2 data-[selected=true]:ring-zinc-900 ${c.hex ? '' : 'bg-zinc-200'}`}
        data-value={c.value}
        data-label={c.label}
        title={c.label}
        style={c.hex ? `background-color: ${c.hex}` : ''}
      >
      </button>
    ))}
  </div>
  <input type="hidden" name={name} id={inputId} class="color-select" value={defaultValue} />
</div>
