---
import { CATEGORIES } from '../../lib/catalog/categories';
---

<header class="sticky top-0 z-40 border-b border-zinc-200 bg-white">
  <!-- Barra superior opcional: moneda -->
  <div class="bg-catalog-600 px-4 py-1.5 text-center text-xs font-medium text-white">
    Todas las monedas están en pesos mexicanos (MXN)
  </div>

  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
    <a href="/tienda" class="flex flex-col text-sm font-bold tracking-tight text-zinc-900 hover:opacity-90">
      <span>TIENDA</span>
      <span class="text-xs font-normal text-zinc-600">Catálogo</span>
    </a>

    <ul class="flex items-center gap-1" role="menubar">
      <li><a href="/tienda" class="rounded px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900">HOME</a></li>
      <li><a href="/tienda" class="rounded px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900">SHOP</a></li>

      {CATEGORIES.map((cat) => (
        <li class="group relative" role="none">
          <button
            type="button"
            class="inline-flex items-center rounded px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 focus:outline-none focus:ring-2 focus:ring-catalog-500"
            aria-haspopup="true"
            aria-expanded="false"
            data-dropdown-trigger
          >
            {cat.label}
          </button>
          <div
            class="absolute left-0 top-full hidden min-w-[180px] rounded-md border border-zinc-200 bg-white py-1 shadow-lg group-hover:block focus-within:block"
            role="menu"
          >
            {cat.subcategories.map((sub) => (
              <a
                href={`/tienda?category=${cat.slug}&product_type=${encodeURIComponent(sub.product_type)}`}
                class="block px-4 py-2 text-sm text-zinc-700 hover:bg-zinc-50 hover:text-catalog-600"
                role="menuitem"
              >
                {sub.label}
              </a>
            ))}
          </div>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href="/admin/login" class="rounded px-3 py-2 text-sm font-medium text-zinc-600 hover:text-zinc-900">LOGIN / REGISTER</a>
      <button type="button" class="rounded p-2 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-700" aria-label="Buscar">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      </button>
      <button type="button" class="rounded p-2 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-700" aria-label="Lista de deseos">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
      </button>
      <button
        type="button"
        id="cart-open-btn"
        class="flex items-center gap-2 rounded bg-zinc-100 px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-200"
        aria-label="Abrir carrito"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        <span id="cart-count" class="text-catalog-600 font-semibold">$0</span>
      </button>
    </div>
  </nav>
</header>

<script>
  import { getCount, getSubtotal } from '../../lib/catalog/cartStore';

  function formatMoney(n: number) {
    return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(n);
  }

  function updateCartBadge() {
    const countEl = document.getElementById('cart-count');
    if (!countEl) return;
    const total = getSubtotal();
    const count = getCount();
    countEl.textContent = count > 0 ? formatMoney(total) : '$0';
  }

  updateCartBadge();
  window.addEventListener('catalog-cart-update', updateCartBadge);

  document.getElementById('cart-open-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('catalog-cart-open'));
  });
</script>
