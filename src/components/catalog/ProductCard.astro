---
import type { ProductRow } from '../../types/catalog';
import { isClothingCategory } from '../../lib/catalog/categories';
import type { ProductRowWithVariants } from '../../lib/catalog/products';

interface Props {
  product: ProductRow | ProductRowWithVariants;
}

const { product } = Astro.props;
const imageUrl = product.image_urls?.[0] ?? '';
const hasSale = product.sale_price != null && product.sale_price < product.price;
const discountPercent = hasSale && product.price > 0
  ? Math.round((1 - Number(product.sale_price) / Number(product.price)) * 100)
  : 0;
const displayPrice = product.sale_price ?? product.price;

const isRopa = isClothingCategory(product.category);
---

<article class="group relative flex flex-col rounded-lg border border-zinc-200 bg-white transition-shadow hover:shadow-md">
  <a href={`/tienda/${product.slug}`} class="relative block aspect-square overflow-hidden rounded-t-lg bg-zinc-100">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={product.name}
        class="h-full w-full object-cover transition group-hover:opacity-95"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-zinc-400">Sin imagen</div>
    )}
    {hasSale && (
      <span class="absolute left-2 top-2 flex h-9 w-9 items-center justify-center rounded-full bg-catalog-500 text-xs font-bold text-white shadow">
        -{discountPercent}%
      </span>
    )}
    <!-- Hover overlay: iconos (no interceptar clics fuera de los botones) -->
    <div class="pointer-events-none absolute inset-0 flex flex-col items-end justify-center gap-2 bg-black/0 pr-2 transition group-hover:bg-black/10 [&_a]:pointer-events-auto [&_button]:pointer-events-auto" aria-hidden="true">
      <a href={`/tienda/${product.slug}`} class="rounded-full bg-white/90 p-2 shadow hover:bg-white" aria-label="Ver producto">
        <svg class="h-4 w-4 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
      </a>
      <button type="button" class="rounded-full bg-white/90 p-2 shadow hover:bg-white" aria-label="Añadir a wishlist">
        <svg class="h-4 w-4 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
      </button>
      {isRopa ? (
        <a href={`/tienda/${product.slug}`} class="rounded-full bg-white/90 p-2 shadow hover:bg-white" aria-label="Ver producto para elegir talla y color">
          <svg class="h-4 w-4 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </a>
      ) : (
        <button
          type="button"
          class="add-to-cart-btn rounded-full bg-white/90 p-2 shadow hover:bg-white"
          aria-label="Añadir al carrito"
          data-product-id={String(product.id)}
          data-product-name={product.name}
          data-product-type={product.product_type}
          data-product-slug={product.slug}
          data-image-url={imageUrl}
          data-price={product.price}
          data-sale-price={product.sale_price ?? ''}
          data-variant-label="Talla"
          data-variant-value="Única"
          data-is-ropa="false"
        >
          <svg class="h-4 w-4 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        </button>
      )}
    </div>
  </a>

  <div class="flex flex-1 flex-col p-3">
    <h2 class="mt-1 line-clamp-2 text-sm font-medium text-zinc-900">
      <a href={`/tienda/${product.slug}`}>{product.name}</a>
    </h2>
    <div class="mt-1 flex gap-0.5 text-amber-500" aria-hidden="true">
      {[1, 2, 3, 4, 5].map(() => (
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
      ))}
    </div>
    <div class="mt-2 flex flex-wrap items-baseline gap-2">
      {hasSale && (
        <span class="text-sm text-zinc-400 line-through">
          {new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(Number(product.price))}
        </span>
      )}
      <span class="text-base font-semibold text-catalog-600">
        {new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(Number(displayPrice))}
      </span>
    </div>
  </div>
</article>
