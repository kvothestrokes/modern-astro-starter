---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost' | 'gold';
  class?: string;
  disabled?: boolean;
  id?: string;
}

const { href, type = 'button', variant = 'primary', class: className = '', disabled = false, id } = Astro.props;

// Dorado en primary refuerza confianza y acción principal; no saturar. Secondary/ghost sin dorado.
const variants = {
  primary:
    'bg-zinc-900 text-white ring-1 ring-gold-500/30 transition-colors transition-shadow hover:bg-zinc-800 hover:ring-gold-400/40 hover:shadow-[0_0_12px_rgba(228,184,74,0.15)] active:scale-[0.98]',
  secondary:
    'bg-white text-zinc-800 ring-1 ring-zinc-300 transition-colors hover:bg-zinc-100 active:scale-[0.98]',
  ghost: 'text-zinc-700 transition-colors hover:bg-zinc-100 active:scale-[0.98]',
  gold:
    'bg-gold-500 hover:bg-gold-600 text-white border border-gold-500 transition-colors shadow active:scale-[0.98]'
};

const baseClasses = `inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium ${variants[variant]} ${className}`;
const disabledClasses = disabled ? ' opacity-60 cursor-not-allowed' : '';
const classes = baseClasses + disabledClasses;
---

{
  href ? (
    <a class={classes} href={href}>
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} disabled={disabled} id={id}>
      <slot />
    </button>
  )
}
