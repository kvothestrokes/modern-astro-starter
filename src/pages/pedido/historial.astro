---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Button from '../../components/ui/Button.astro';
---

<PublicLayout title="Mis pedidos">
  <section class="mx-auto max-w-3xl">
    <h1 class="text-xl font-semibold text-zinc-900">Mis pedidos</h1>
    <p class="mt-1 text-sm text-zinc-600">
      Aquí se muestran los pedidos creados desde este navegador. Fecha y productos de cada pedido.
    </p>
    <div id="historial-container" class="mt-6" aria-live="polite">
      <p class="text-sm text-zinc-500">Cargando…</p>
    </div>
    <div class="mt-6">
      <Button href="/pedido" variant="secondary">Nuevo pedido</Button>
    </div>
  </section>
</PublicLayout>

<script>
  import './historial-client';
</script>
