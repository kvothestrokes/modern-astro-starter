---
import PublicLayout from '../../layouts/PublicLayout.astro';
import StepHeader from '../../components/order/StepHeader.astro';
import OrderProgress from '../../components/order/OrderProgress.astro';
import Button from '../../components/ui/Button.astro';
---

<PublicLayout title="Revisa tu pedido">
  <OrderProgress current={3} />
  <StepHeader
    title="Revisa tu pedido"
    subtitle="Comprueba que todo esté correcto. Si algo falta, vuelve al paso anterior. Cuando estés listo, confirma y envía."
  />

  <section class="rounded-xl border-2 border-zinc-200 bg-white p-4 md:p-6">
    <h2 class="mb-3 text-base font-semibold text-zinc-900">Datos del cliente</h2>
    <div id="reviewCustomer" class="grid gap-2 text-sm text-zinc-700 md:grid-cols-2"></div>
  </section>

  <section class="mt-4 rounded-xl border-2 border-zinc-200 bg-white p-4 md:p-6">
    <h2 class="mb-3 text-base font-semibold text-zinc-900">Productos del pedido</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-zinc-700">
        <thead>
          <tr class="border-b border-zinc-200 text-left text-xs uppercase text-zinc-500">
            <th class="pb-2 pr-3">Producto</th>
            <th class="pb-2 pr-3">Talla</th>
            <th class="pb-2 pr-3">Color</th>
            <th class="pb-2 pr-3">Cantidad</th>
            <th class="pb-2 pr-3">Diseños y posiciones</th>
          </tr>
        </thead>
        <tbody id="reviewProducts"></tbody>
      </table>
    </div>
    <p id="reviewProductsEmpty" class="mt-2 text-sm text-zinc-500 hidden">No hay productos.</p>
  </section>

  <section class="mt-4 rounded-xl border-2 border-zinc-200 bg-white p-4 md:p-6">
    <h2 class="mb-3 text-base font-semibold text-zinc-900">Diseños y a qué productos van</h2>
    <div id="reviewDesigns" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <p id="reviewDesignsEmpty" class="mt-2 text-sm text-zinc-500 hidden">No hay diseños.</p>
  </section>

  <p class="mt-6 text-sm text-zinc-500">
    Si algo no es claro, <a href="mailto:contacto@ouroboros.com" class="underline transition-colors hover:text-zinc-700">contáctanos</a>.
  </p>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
    <Button href="/pedido/productos" variant="secondary">Volver a productos</Button>
    <div class="flex items-center gap-2">
      <Button type="button" id="confirmSubmit" variant="gold" class="px-6 py-3 shadow">
        Confirmar y enviar pedido
      </Button>
    </div>
  </div>
  <p id="submitFeedback" class="mt-3 text-sm text-zinc-600"></p>
  <p id="supabaseHint" class="mt-1 text-xs text-zinc-500 hidden">Configura Supabase para enviar el pedido; el resto del flujo funciona igual.</p>
</PublicLayout>

<script>
  import './revision-client';
</script>
