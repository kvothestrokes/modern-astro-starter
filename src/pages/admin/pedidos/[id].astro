---
import { createClient } from '@supabase/supabase-js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import { STATUS_BADGE_CLASS, STATUS_LABELS } from '../../../lib/constants';
import type { DesignStatus } from '../../../types/status';

const { id } = Astro.params;
const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

const { data: order } = await supabase
  .from('orders')
  .select('id, created_at, status, customers(name, email, phone), garments(*), designs(*)')
  .eq('id', id)
  .single();

const { data: assignments = [] } = await supabase.from('design_assignments').select('*');
---

<AdminLayout title={`Pedido ${id}`}>
  <div class="mb-3">
  <Button href="/admin/pedidos" variant="secondary">Volver a pedidos</Button>
</div>
  <h1 class="text-xl font-semibold">Pedido {id?.slice(0, 8)}</h1>
  {
    !order ? (
      <p class="mt-3 text-sm text-zinc-600">No encontramos ese pedido.</p>
    ) : (
      <>
        <section class="mt-4 rounded-xl border border-zinc-200 bg-white p-4 text-sm">
          <p><strong>Cliente:</strong> {order.customers?.name || '-'}</p>
          <p><strong>Correo:</strong> {order.customers?.email || '-'}</p>
          <p><strong>Telefono:</strong> {order.customers?.phone || '-'}</p>
          <p><strong>Fecha:</strong> {new Date(order.created_at).toLocaleString('es-MX')}</p>
        </section>

        <section class="mt-4 grid gap-4 md:grid-cols-2">
          <article class="rounded-xl border border-zinc-200 bg-white p-4">
            <h2 class="text-sm font-semibold">Productos</h2>
            <ul class="mt-2 space-y-2 text-sm">
              {order.garments?.map((item: any) => <li>{item.product_type} | {item.size || '-'} | {item.color || '-'} | {item.quantity}</li>)}
            </ul>
          </article>
          <article class="rounded-xl border border-zinc-200 bg-white p-4">
            <h2 class="text-sm font-semibold">Diseños</h2>
            <div class="mt-2 space-y-3 text-sm">
              {order.designs?.map((design: any) => {
                const tone = STATUS_BADGE_CLASS[(design.status || 'falta_diseno') as DesignStatus];
                const label = STATUS_LABELS[(design.status || 'falta_diseno') as DesignStatus];
                const assignedCount = assignments.filter((item: any) => item.design_id === design.id).length;
                return (
                  <article class="rounded border border-zinc-200 p-2">
                    <img class="h-24 w-24 rounded object-cover" src={design.original_image_url} alt="Diseño" />
                    <div class="mt-2">
                      <Badge label={label} tone={tone} />
                      <p class="mt-1 text-xs text-zinc-600">Asignado a {assignedCount} producto(s)</p>
                    </div>
                    <a class="mt-2 inline-flex rounded border border-zinc-300 px-2 py-1 text-xs" href={design.original_image_url} download>
                      Descargar original
                    </a>
                  </article>
                );
              })}
            </div>
          </article>
        </section>
      </>
    )
  }
</AdminLayout>
