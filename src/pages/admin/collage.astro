---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
---

<AdminLayout title="Admin | Collage">
  <h1 class="text-xl font-semibold tracking-tight">Collage de imágenes</h1>
  <p class="mt-1 text-sm text-zinc-600">
    Añade entre 6 y 12 imágenes, ajusta zoom y posición en cada celda, reordena arrastrando y exporta en JPG.
  </p>

  <section class="mt-4 rounded-xl border border-zinc-200 bg-white p-4">
    <h2 class="text-sm font-semibold">Añadir imágenes</h2>
    <div class="mt-3 flex flex-wrap items-end gap-3">
      <label class="flex flex-col gap-1">
        <span class="text-xs text-zinc-600">Desde archivos</span>
        <input
          id="collageFileInput"
          type="file"
          accept="image/*"
          multiple
          class="rounded border border-zinc-300 px-2 py-1 text-sm file:mr-2 file:rounded file:border-0 file:bg-zinc-100 file:px-3 file:py-1 file:text-sm"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs text-zinc-600">Desde URL</span>
        <input
          id="collageUrlInput"
          type="url"
          placeholder="https://..."
          class="w-64 rounded border border-zinc-300 px-3 py-2 text-sm focus:ring-2 focus:ring-gold-500/20"
        />
      </label>
      <button
        id="collageAddUrlBtn"
        type="button"
        class="rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50"
      >
        Añadir URL
      </button>
    </div>
    <p id="collageMessage" class="text-zinc-600 text-sm mt-1" aria-live="polite"></p>
    <div id="collageThumbnails" class="mt-3 flex flex-wrap gap-2"></div>
  </section>

  <section id="collageContainer" class="mt-4 rounded-xl border border-zinc-200 bg-white p-4 hidden">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-sm font-semibold">Vista previa del collage</h2>
      <div class="flex flex-wrap items-center gap-3">
        <label class="flex items-center gap-2 text-sm">
          <input id="collageGrayscale" type="checkbox" class="rounded border-zinc-300 text-gold-500 focus:ring-gold-500/20" />
          Blanco y negro
        </label>
        <label class="flex items-center gap-2 text-sm" title="O mantén Ctrl al arrastrar para reposicionar la imagen dentro de la celda">
          <input id="collagePanMode" type="checkbox" class="rounded border-zinc-300 text-gold-500 focus:ring-gold-500/20" />
          Reposicionar imagen
        </label>
        <label class="flex items-center gap-2 text-sm">
          <span>Resolución export:</span>
          <select id="collageResolution" class="rounded border border-zinc-300 px-2 py-1 text-sm">
            <option value="1280">1280 px</option>
            <option value="1920" selected>1920 px (HD)</option>
          </select>
        </label>
        <Button type="button" id="collageExportBtn" variant="gold">
          Exportar JPG
        </Button>
      </div>
    </div>
    <div
      class="mt-3 aspect-square w-full max-w-2xl overflow-hidden rounded-lg border border-zinc-200 bg-zinc-100 transition-[filter] duration-200"
      style="filter: none;"
    >
      <canvas id="collageCanvas"></canvas>
    </div>
    <p class="mt-2 text-xs text-zinc-500">
      Arrastra imágenes entre celdas para cambiar el orden. Para mover una imagen dentro de su celda (zoom ya aplicado), activa «Reposicionar imagen» o mantén <kbd class="rounded border border-zinc-300 bg-zinc-100 px-1">Ctrl</kbd> al arrastrar.
    </p>
  </section>
</AdminLayout>

<style>
  #collageContainer.grayscale .aspect-square {
    filter: grayscale(100%);
  }
  #collageCanvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import './collage-client';
</script>
