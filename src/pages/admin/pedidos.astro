---
import { createClient } from '@supabase/supabase-js';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Table from '../../components/ui/Table.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Pagination from '../../components/admin/Pagination.astro';
import { ALL_DESIGN_STATUSES, STATUS_BADGE_CLASS, STATUS_LABELS } from '../../lib/constants';
import type { DesignStatus } from '../../types/status';

const page = Number(Astro.url.searchParams.get('page') || '1');
const status = Astro.url.searchParams.get('status') || '';
const q = Astro.url.searchParams.get('q') || '';
const pageSize = 20;
const from = (page - 1) * pageSize;
const to = from + pageSize - 1;

const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

let query = supabase
  .from('orders')
  .select(
    `
    id,
    status,
    created_at,
    customers(name),
    garments(id, product_type, quantity),
    designs(id, original_image_url, status)
  `,
    { count: 'exact' }
  )
  .order('created_at', { ascending: false })
  .range(from, to);

if (status) query = query.eq('status', status);
if (q) query = query.ilike('id', `%${q}%`);

const { data: orders = [], error, count } = await query;
const hasNext = Boolean(count && count > page * pageSize);
---

<AdminLayout title="Admin | Pedidos">
  <h1 class="text-xl font-semibold tracking-tight">Pedidos</h1>

  <form class="mt-4 grid gap-2 rounded-xl border border-zinc-200 bg-white p-3 md:grid-cols-[1fr_220px_auto]">
    <input
      name="q"
      value={q}
      placeholder="Buscar por ID de pedido"
      class="rounded-lg border border-zinc-300 px-3 py-2 text-sm"
    />
    <select name="status" class="rounded-lg border border-zinc-300 px-3 py-2 text-sm">
      <option value="">Todos los estados</option>
      {
        ALL_DESIGN_STATUSES.map((item) => (
          <option selected={item === status} value={item}>
            {STATUS_LABELS[item]}
          </option>
        ))
      }
    </select>
    <Button type="submit" variant="secondary">Filtrar</Button>
  </form>

  {error && <p class="mt-3 text-sm text-red-600">No pudimos cargar los pedidos. Vuelve a intentar en un momento.</p>}

  {
    orders.length === 0 ? (
      <div class="mt-4">
        <EmptyState title="Sin pedidos" description="No encontramos resultados con esos filtros." />
      </div>
    ) : (
      <div class="mt-4">
        <Table>
          <thead class="border-b border-zinc-200 bg-zinc-50 text-left text-xs uppercase text-zinc-600">
            <tr>
              <th class="px-3 py-2">Pedido</th>
              <th class="px-3 py-2">Cliente</th>
              <th class="px-3 py-2">Producto</th>
              <th class="px-3 py-2">Diseño</th>
              <th class="px-3 py-2">Cantidad</th>
              <th class="px-3 py-2">Estado</th>
              <th class="px-3 py-2">Fecha</th>
              <th class="px-3 py-2">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {
              orders.map((order: any) => {
                const firstProduct = order.garments?.[0];
                const totalQty = (order.garments || []).reduce((sum: number, item: any) => sum + item.quantity, 0);
                const firstDesign = order.designs?.[0];
                const designStatus = (firstDesign?.status || 'falta_diseno') as DesignStatus;
                return (
                  <tr class="border-b border-zinc-100 align-top text-sm">
                    <td class="px-3 py-2 font-mono text-xs">{order.id.slice(0, 8)}</td>
                    <td class="px-3 py-2">{order.customers?.name || '-'}</td>
                    <td class="px-3 py-2">{firstProduct?.product_type || '-'}</td>
                    <td class="px-3 py-2">
                      {firstDesign ? <img class="h-14 w-14 rounded object-cover" src={firstDesign.original_image_url} alt="Diseño" /> : '-'}
                    </td>
                    <td class="px-3 py-2">{totalQty}</td>
                    <td class="px-3 py-2">
                      <Badge label={STATUS_LABELS[designStatus]} tone={STATUS_BADGE_CLASS[designStatus]} />
                      {firstDesign && (
                        <div class="mt-2">
                          <select
                            data-design-id={firstDesign.id}
                            class="statusSelect rounded border border-zinc-300 px-2 py-1 text-xs"
                          >
                            {ALL_DESIGN_STATUSES.map((value) => <option selected={value === designStatus}>{value}</option>)}
                          </select>
                        </div>
                      )}
                    </td>
                    <td class="px-3 py-2 text-xs text-zinc-600">{new Date(order.created_at).toLocaleDateString('es-MX')}</td>
                    <td class="px-3 py-2">
                      <a class="rounded border border-zinc-300 px-2 py-1 text-xs" href={`/admin/pedidos/${order.id}`}>Ver</a>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </Table>
        <Pagination page={page} hasNext={hasNext} basePath="/admin/pedidos" status={status} search={q} />
      </div>
    )
  }
</AdminLayout>

<script>
  import './pedidos-client';
</script>
