---
import { createClient } from '@supabase/supabase-js';
import AdminLayout from '../../layouts/AdminLayout.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { STATUS_BADGE_CLASS, STATUS_LABELS } from '../../lib/constants';
import { STATUS_GROUP_ACTIVOS, STATUS_GROUP_ESPERA, STATUS_GROUP_FINALES } from '../../lib/order-status';

const INITIAL_LIMIT = 500;

const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

const { data: orders = [], error } = await supabase
  .from('orders')
  .select(
    `
    id,
    status,
    created_at,
    customers(name, notes),
    garments(id, product_type, quantity),
    designs(id, original_image_url, status)
  `
  )
  .order('created_at', { ascending: false })
  .limit(INITIAL_LIMIT);

const ordersData = {
  orders,
  labels: STATUS_LABELS,
  badgeClass: STATUS_BADGE_CLASS,
  statusGroups: {
    activos: STATUS_GROUP_ACTIVOS,
    espera: STATUS_GROUP_ESPERA,
    finales: STATUS_GROUP_FINALES
  }
};
---

<AdminLayout title="Admin | Pedidos">
  <h1 class="text-xl font-semibold tracking-tight">Pedidos</h1>

  <div id="pedidos-toolbar" class="relative mt-4 flex flex-wrap items-center gap-2">
    <input
      type="search"
      id="pedidos-search"
      placeholder="Buscar por ID, cliente, producto..."
      class="rounded-lg border border-zinc-300 px-3 py-1.5 text-sm"
      aria-label="Buscar pedidos"
    />
    <div id="pedidos-quick-filters" class="flex flex-wrap gap-1.5"></div>
    <button
      type="button"
      id="pedidos-btn-actualizar"
      class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm hover:bg-zinc-50"
    >
      Actualizar
    </button>
    <div class="ml-auto flex items-center gap-2 relative">
      <div class="relative">
        <button
          type="button"
          id="pedidos-btn-columnas"
          class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm hover:bg-zinc-50"
          aria-haspopup="true"
          aria-expanded="false"
          data-pedidos-action="toggle-columnas"
        >
          Columnas
        </button>
        <div id="pedidos-dropdown-columnas" class="absolute right-0 top-full z-[100] mt-1 min-w-[160px] rounded-lg border border-zinc-200 bg-white p-2 shadow-lg hidden" role="menu" aria-label="Mostrar u ocultar columnas"></div>
      </div>
      <div class="relative">
        <button
          type="button"
          id="pedidos-btn-vistas"
          class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm hover:bg-zinc-50"
          aria-haspopup="true"
          aria-expanded="false"
          data-pedidos-action="toggle-vistas"
        >
          Vistas
        </button>
        <div id="pedidos-dropdown-vistas" class="absolute right-0 top-full z-[100] mt-1 min-w-[180px] rounded-lg border border-zinc-200 bg-white p-2 shadow-lg hidden" role="menu" aria-label="Vistas guardadas"></div>
      </div>
    </div>
  </div>

  {error && (
    <p class="mt-3 text-sm text-red-600">No pudimos cargar los pedidos. Vuelve a intentar en un momento.</p>
  )}

  {orders.length > 0 && (
    <>
      <div id="pedidos-summary" class="mt-2 text-sm text-zinc-600" aria-live="polite"></div>

  <div id="pedidos-table-wrapper" class="mt-4 overflow-x-auto rounded-xl border border-zinc-200 bg-white" role="region" aria-label="Tabla de pedidos">
    <table id="pedidos-table" class="min-w-full table-fixed text-sm" data-columns="id,cliente,producto,diseno,cantidad,estado,fecha,acciones" role="grid">
      <thead class="border-b border-zinc-200 bg-zinc-50 text-left text-xs uppercase text-zinc-600">
        <tr>
          <th class="pedidos-th px-3 py-2" data-column="id" data-sortable="true" data-type="text">
            <span class="flex items-center gap-1">
              Pedido
              <button type="button" class="pedidos-sort-btn opacity-60 hover:opacity-100" aria-label="Ordenar">↕</button>
              <button type="button" class="pedidos-filter-btn opacity-60 hover:opacity-100" aria-label="Filtrar">▾</button>
            </span>
          </th>
          <th class="pedidos-th px-3 py-2" data-column="cliente" data-sortable="true" data-type="text">
            <span class="flex items-center gap-1">
              Cliente
              <button type="button" class="pedidos-sort-btn opacity-60 hover:opacity-100" aria-label="Ordenar">↕</button>
              <button type="button" class="pedidos-filter-btn opacity-60 hover:opacity-100" aria-label="Filtrar">▾</button>
            </span>
          </th>
          <th class="pedidos-th px-3 py-2" data-column="producto" data-sortable="true" data-type="text">
            <span class="flex items-center gap-1">
              Producto
              <button type="button" class="pedidos-sort-btn opacity-60 hover:opacity-100" aria-label="Ordenar">↕</button>
              <button type="button" class="pedidos-filter-btn opacity-60 hover:opacity-100" aria-label="Filtrar">▾</button>
            </span>
          </th>
          <th class="pedidos-th px-3 py-2" data-column="diseno" data-sortable="false" data-type="text">
            <span class="flex items-center gap-1">
              Diseño
              <button type="button" class="pedidos-filter-btn opacity-60 hover:opacity-100" aria-label="Filtrar">▾</button>
            </span>
          </th>
          <th class="pedidos-th px-3 py-2" data-column="cantidad" data-sortable="true" data-type="number">
            <span class="flex items-center gap-1">
              Cantidad
              <button type="button" class="pedidos-sort-btn opacity-60 hover:opacity-100" aria-label="Ordenar">↕</button>
              <button type="button" class="pedidos-filter-btn opacity-60 hover:opacity-100" aria-label="Filtrar">▾</button>
            </span>
          </th>
          <th class="pedidos-th px-3 py-2 sticky left-0 z-10 bg-zinc-50" data-column="estado" data-sortable="true" data-type="status">
            <span class="flex items-center gap-1">
              Estado
              <button type="button" class="pedidos-sort-btn opacity-60 hover:opacity-100" aria-label="Ordenar">↕</button>
              <button type="button" class="pedidos-filter-btn opacity-60 hover:opacity-100" aria-label="Filtrar">▾</button>
            </span>
          </th>
          <th class="pedidos-th px-3 py-2" data-column="fecha" data-sortable="true" data-type="date">
            <span class="flex items-center gap-1">
              Fecha
              <button type="button" class="pedidos-sort-btn opacity-60 hover:opacity-100" aria-label="Ordenar">↕</button>
              <button type="button" class="pedidos-filter-btn opacity-60 hover:opacity-100" aria-label="Filtrar">▾</button>
            </span>
          </th>
          <th class="pedidos-th px-3 py-2 sticky right-0 z-10 bg-zinc-50" data-column="acciones" data-sortable="false" data-type="text">
            Acciones
          </th>
        </tr>
      </thead>
      <tbody id="pedidos-tbody" class="text-sm">
        <!-- Client hydrates rows here -->
      </tbody>
    </table>
  </div>

      <div id="pedidos-pagination" class="mt-4 flex items-center justify-between"></div>
    </>
  )}

  {orders.length === 0 && !error && (
    <div class="mt-4">
      <EmptyState title="Sin pedidos" description="No hay pedidos para mostrar." />
    </div>
  )}
</AdminLayout>

<script define:vars={{ ordersData }}>
  try { window.__PEDIDOS_DATA__ = ordersData; } catch (_) {}
</script>
<script>
  import './pedidos-client';
</script>
