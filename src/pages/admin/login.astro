---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout title="Login admin">
  <section class="mx-auto max-w-md rounded-xl border border-zinc-200 bg-white p-5">
    <h1 class="text-lg font-semibold">Acceso interno</h1>
    <p class="mt-1 text-sm text-zinc-600">Usa tu cuenta de Supabase Auth para entrar al dashboard.</p>

    <form id="adminLoginForm" class="mt-4 grid gap-3">
      <label class="grid gap-1 text-sm">
        <span class="font-medium">Correo</span>
        <input name="email" type="email" required class="rounded-lg border border-zinc-300 px-3 py-2" />
      </label>
      <label class="grid gap-1 text-sm">
        <span class="font-medium">Contrasena</span>
        <input name="password" type="password" required class="rounded-lg border border-zinc-300 px-3 py-2" />
      </label>
      <button class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white" type="submit">Entrar</button>
      <p id="loginFeedback" class="text-sm text-zinc-600"></p>
    </form>
  </section>
</PublicLayout>

<script>
  import './login-client';
</script>
