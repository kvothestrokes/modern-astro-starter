---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listProductsAdmin, toggleProductActive } from '../../../lib/catalog/admin-products';

export const prerender = false;

let message = '';
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');
  const id = formData.get('id') as string | null;
  if (action === 'toggle' && id) {
    try {
      const current = formData.get('is_active');
      const isActive = current !== 'true';
      await toggleProductActive(id, isActive);
      message = isActive ? 'Producto activado.' : 'Producto desactivado.';
    } catch (e) {
      message = 'Error: ' + (e instanceof Error ? e.message : String(e));
    }
    return Astro.redirect('/admin/productos?msg=' + encodeURIComponent(message));
  }
}

const url = Astro.url;
const msg = url.searchParams.get('msg') ?? '';
const filterActive = url.searchParams.get('active');
const isActiveFilter = filterActive === 'true' ? true : filterActive === 'false' ? false : undefined;

const { data: products, count } = await listProductsAdmin({
  is_active: isActiveFilter,
  page: 1,
  pageSize: 50
});
---

<AdminLayout title="Productos | Admin">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-xl font-semibold tracking-tight">Productos</h1>
    <a
      href="/admin/productos/nuevo"
      class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800"
    >
      Nuevo producto
    </a>
  </div>

  {msg && <p class="mt-2 rounded bg-green-100 p-2 text-sm text-green-800">{msg}</p>}

  <div class="mt-4 flex gap-2">
    <a
      href="/admin/productos"
      class={`rounded px-3 py-1.5 text-sm ${isActiveFilter === undefined ? 'bg-zinc-200 font-medium' : 'bg-zinc-100 hover:bg-zinc-200'}`}
    >
      Todos
    </a>
    <a
      href="/admin/productos?active=true"
      class={`rounded px-3 py-1.5 text-sm ${isActiveFilter === true ? 'bg-zinc-200 font-medium' : 'bg-zinc-100 hover:bg-zinc-200'}`}
    >
      Activos
    </a>
    <a
      href="/admin/productos?active=false"
      class={`rounded px-3 py-1.5 text-sm ${isActiveFilter === false ? 'bg-zinc-200 font-medium' : 'bg-zinc-100 hover:bg-zinc-200'}`}
    >
      Inactivos
    </a>
  </div>

  <div class="mt-4 overflow-x-auto rounded-lg border border-zinc-200 bg-white">
    <table class="w-full min-w-[700px] text-sm text-zinc-700">
      <thead class="border-b border-zinc-200 bg-zinc-50 text-left text-xs font-medium uppercase text-zinc-500">
        <tr>
          <th class="px-4 py-3">Nombre</th>
          <th class="px-4 py-3">Tipo</th>
          <th class="px-4 py-3">Categoría</th>
          <th class="px-4 py-3">Precio</th>
          <th class="px-4 py-3">Oferta</th>
          <th class="px-4 py-3">Activo</th>
          <th class="px-4 py-3 text-right">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {products.length === 0 ? (
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-zinc-500">No hay productos.</td>
          </tr>
        ) : (
          products.map((p) => (
            <tr class="border-b border-zinc-100 hover:bg-zinc-50">
              <td class="px-4 py-3 font-medium text-zinc-900">{p.name}</td>
              <td class="px-4 py-3">{p.product_type}</td>
              <td class="px-4 py-3">{p.category}</td>
              <td class="px-4 py-3">{new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(Number(p.price))}</td>
              <td class="px-4 py-3">{p.sale_price != null ? new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(Number(p.sale_price)) : '—'}</td>
              <td class="px-4 py-3">{p.is_active ? 'Sí' : 'No'}</td>
              <td class="px-4 py-3 text-right">
                <a href={`/admin/productos/editar/${p.id}`} class="text-catalog-600 hover:underline">Editar</a>
                {' '}
                <form method="post" action="/admin/productos" class="inline">
                  <input type="hidden" name="action" value="toggle" />
                  <input type="hidden" name="id" value={p.id} />
                  <input type="hidden" name="is_active" value={String(p.is_active)} />
                  <button type="submit" class="text-zinc-600 hover:underline">
                    {p.is_active ? 'Desactivar' : 'Activar'}
                  </button>
                </form>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
