---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import ProductGallery from '../../components/catalog/ProductGallery.astro';
import VariantSelector from '../../components/catalog/VariantSelector.astro';
import ColorSwatches from '../../components/catalog/ColorSwatches.astro';
import { getProductBySlug } from '../../lib/catalog/products';
import { isClothingCategory } from '../../lib/catalog/categories';
import { COLORS } from '../../lib/productOptions';

export const prerender = false;

const DEFAULT_CLOTHING_SIZES = ['S', 'M', 'L', 'XL'];

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/tienda');

const product = await getProductBySlug(slug);
if (!product) return Astro.redirect('/tienda');

const imageUrls = product.image_urls ?? [];
const hasSale = product.sale_price != null && product.sale_price < product.price;
const discountPercent = hasSale && product.price > 0
  ? Math.round((1 - Number(product.sale_price) / Number(product.price)) * 100)
  : undefined;
const displayPrice = product.sale_price ?? product.price;
const variants = product.product_variants ?? [];
const sizeOnlyVariants = variants.filter((v) => v.label !== 'Color');
const isRopa = isClothingCategory(product.category);
const showDefaultSizeSelector = isRopa && variants.length === 0;
const sizeVariantValues = sizeOnlyVariants.filter((v) => v.label === 'Talla').map((v) => v.value);
const sizeOptions = sizeVariantValues.length > 0 ? sizeVariantValues : (showDefaultSizeSelector ? DEFAULT_CLOTHING_SIZES : []);
const hasSizeSelector = sizeOptions.length > 0;
const otherVariants = sizeOnlyVariants.filter((v) => v.label !== 'Talla');

const productPageData = JSON.stringify({
  product: {
    id: product.id,
    name: product.name,
    product_type: product.product_type,
    slug: product.slug,
    image_urls: product.image_urls,
    price: product.price,
    sale_price: product.sale_price
  },
  isRopa
}).replace(/<\/script>/gi, '<\\/script>');
---

<CatalogLayout title={`${product.name} | Tienda`}>
  <div class="mx-auto max-w-7xl px-4 py-6">
    <nav class="mb-4 text-sm text-zinc-500" aria-label="Breadcrumb">
      <a href="/tienda" class="hover:text-zinc-700">Home</a>
      <span class="mx-1">/</span>
      <a href={`/tienda?category=${product.category}`} class="hover:text-zinc-700">{product.category}</a>
      <span class="mx-1">/</span>
      <span>{product.name}</span>
    </nav>

    <div class="grid gap-8 md:grid-cols-2">
      <ProductGallery
        imageUrls={imageUrls}
        productName={product.name}
        discountPercent={discountPercent}
      />

      <div>
        <h1 class="text-2xl font-semibold text-zinc-900">{product.name}</h1>
        <div class="mt-2 flex gap-1 text-amber-500" aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => (
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          ))}
        </div>
        <p class="mt-1 text-sm text-zinc-500">(1 reseña)</p>

        <div class="mt-4 flex flex-wrap items-baseline gap-2">
          {hasSale && (
            <span class="text-lg text-zinc-400 line-through">
              {new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(Number(product.price))}
            </span>
          )}
          <span class="text-2xl font-bold text-catalog-600">
            {new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(Number(displayPrice))}
          </span>
        </div>

        <p class="mt-2 flex items-center gap-1 text-sm text-catalog-600">
          <span aria-hidden="true">🔥</span>
          18 vendidos en los últimos 3 min.
        </p>

        <form id="product-form" class="mt-6 space-y-4">
          {hasSizeSelector ? (
            <div class="space-y-2">
              <label class="mb-1 block text-sm font-medium text-zinc-700">Talla *</label>
              <input
                type="hidden"
                name="variant_Talla"
                class="variant-select product-size-input"
                data-variant-label="Talla"
                value=""
              />
              <div class="product-size-chips flex flex-wrap gap-2" role="group" aria-label="Elegir talla">
                {sizeOptions.map((s) => (
                  <button
                    type="button"
                    class="size-chip min-w-[2.5rem] rounded border border-zinc-300 bg-white px-3 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-400 hover:bg-zinc-50 focus:outline-none focus:ring-2 focus:ring-catalog-500 focus:ring-offset-1 data-[selected=true]:border-catalog-500 data-[selected=true]:bg-catalog-500 data-[selected=true]:text-white"
                    data-size={s}
                  >
                    {s}
                  </button>
                ))}
              </div>
              <p class="size-required-message mt-1 hidden text-xs text-red-600" role="alert">
                Debe seleccionar la talla primero.
              </p>
            </div>
          ) : otherVariants.length > 0 ? (
            <VariantSelector name={product.id} variants={otherVariants} required />
          ) : (
            <input type="hidden" name="variant_Talla" class="variant-select" data-variant-label="Talla" value="Única" />
          )}

          {isRopa && (
            <div class="space-y-1">
              <ColorSwatches
                colors={COLORS}
                name="color"
                containerId="productColorSwatches"
                inputId="productColorInput"
                defaultValue="Negro"
                label="Color"
              />
            </div>
          )}

          <div>
            <label for="qty" class="mb-1 block text-sm font-medium text-zinc-700">Cantidad</label>
            <div class="flex w-32 items-center rounded border border-zinc-300">
              <button type="button" id="qty-minus" class="flex h-10 w-10 items-center justify-center border-r border-zinc-300 hover:bg-zinc-50" aria-label="Menos">−</button>
              <input type="number" id="qty" name="quantity" min="1" value="1" class="h-10 w-12 border-0 text-center text-zinc-900" />
              <button type="button" id="qty-plus" class="flex h-10 w-10 items-center justify-center border-l border-zinc-300 hover:bg-zinc-50" aria-label="Más">+</button>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <button
              type="submit"
              id="add-to-cart-product"
              class="w-full rounded bg-catalog-500 py-3 font-medium text-white hover:bg-catalog-600 focus:outline-none focus:ring-2 focus:ring-catalog-500"
            >
              AÑADIR AL CARRITO
            </button>
            <button
              type="button"
              id="buy-now-btn"
              class="w-full rounded border-2 border-catalog-500 py-2 font-medium text-catalog-600 hover:bg-catalog-50 focus:outline-none focus:ring-2 focus:ring-catalog-500"
            >
              COMPRAR AHORA
            </button>
          </div>
        </form>

        <div class="mt-4 flex gap-4 text-sm text-zinc-600">
          <button type="button" class="flex items-center gap-1 hover:text-zinc-900">📋 Comparar</button>
          <button type="button" class="flex items-center gap-1 hover:text-zinc-900">❤ Añadir a wishlist</button>
        </div>
        <p class="mt-2 flex items-center gap-1 text-sm text-zinc-500">
          <span aria-hidden="true">👁</span>
          19 personas viendo este producto ahora.
        </p>
      </div>
    </div>
  </div>
</CatalogLayout>

<script id="product-page-data" type="application/json" set:html={productPageData} />

<script>
  import { addItem, checkoutToPedido } from '../../lib/catalog/cartStore';

  const dataEl = document.getElementById('product-page-data');
  const { product, isRopa } = dataEl ? JSON.parse(dataEl.textContent || '{}') : { product: null, isRopa: false };

  const form = document.getElementById('product-form');
  const buyNowBtn = document.getElementById('buy-now-btn');
  const qtyInput = document.getElementById('qty');
  const qtyMinus = document.getElementById('qty-minus');
  const qtyPlus = document.getElementById('qty-plus');

  const sizeChipsContainer = form?.querySelector('.product-size-chips');
  const sizeInput = form?.querySelector('.product-size-input');
  const sizeRequiredMsg = form?.querySelector('.size-required-message');

  if (sizeChipsContainer && sizeInput) {
    sizeChipsContainer.querySelectorAll('.size-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-size') ?? '';
        sizeInput.value = size;
        sizeChipsContainer.querySelectorAll('.size-chip').forEach((b) => b.removeAttribute('data-selected'));
        btn.setAttribute('data-selected', 'true');
        if (sizeRequiredMsg) sizeRequiredMsg.classList.add('hidden');
      });
    });
  }

  function getSelectedVariants() {
    const variantEls = form?.querySelectorAll('.variant-select') ?? [];
    let label = 'Talla';
    let value = 'Única';
    let size, color;
    const colorInput = form?.querySelector('input[name="color"]');
    if (colorInput?.value) color = colorInput.value.trim();
    variantEls.forEach((el) => {
      const l = el.getAttribute('data-variant-label') ?? 'Talla';
      const v = (el.value ?? '').trim() || 'Única';
      if (l === 'Talla') size = v;
      else if (l === 'Color' && !color) color = v;
    });
    if (variantEls.length > 0) {
      const first = variantEls[0];
      label = first.getAttribute('data-variant-label') ?? 'Talla';
      value = (first.value ?? '').trim() || 'Única';
      if (!size && label === 'Talla') size = value;
      if (!color && label === 'Color') color = value;
    }
    return { label, value, size, color };
  }

  function addToCartAndMaybeCheckout(redirectToPedido) {
    if (!product) return;
    const { label, value, size, color } = getSelectedVariants();
    const requiresSize = isRopa && sizeInput;
    if (requiresSize && (!size || size === 'Única')) {
      if (sizeRequiredMsg) sizeRequiredMsg.classList.remove('hidden');
      const firstChip = sizeChipsContainer?.querySelector('.size-chip');
      if (firstChip && typeof firstChip.focus === 'function') firstChip.focus();
      return;
    }
    if (sizeRequiredMsg) sizeRequiredMsg.classList.add('hidden');
    const qty = Math.max(1, parseInt(qtyInput?.value || '1', 10));
    addItem({
      productId: product.id,
      name: product.name,
      product_type: product.product_type,
      slug: product.slug,
      imageUrl: (product.image_urls && product.image_urls[0]) ?? '',
      price: Number(product.price),
      sale_price: product.sale_price != null ? Number(product.sale_price) : null,
      quantity: qty,
      variant: { label, value },
      size,
      color
    });
    if (redirectToPedido) {
      checkoutToPedido();
    } else {
      window.dispatchEvent(new CustomEvent('catalog-cart-open'));
    }
  }

  const productColorSwatches = document.getElementById('productColorSwatches');
  const productColorInput = document.getElementById('productColorInput');
  if (productColorSwatches) {
    productColorSwatches.querySelectorAll('.color-swatch').forEach((btn) => {
      btn.addEventListener('click', () => {
        productColorSwatches.querySelectorAll('.color-swatch').forEach((b) => b.removeAttribute('data-selected'));
        btn.setAttribute('data-selected', 'true');
        const val = btn.getAttribute('data-value') || 'Negro';
        if (productColorInput) productColorInput.value = val;
      });
    });
    const firstNegro = productColorSwatches.querySelector('[data-value="Negro"]');
    if (firstNegro) firstNegro.setAttribute('data-selected', 'true');
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    addToCartAndMaybeCheckout(false);
  });
  buyNowBtn?.addEventListener('click', () => addToCartAndMaybeCheckout(true));
  qtyMinus?.addEventListener('click', () => {
    if (qtyInput) qtyInput.value = String(Math.max(1, parseInt(qtyInput.value, 10) - 1));
  });
  qtyPlus?.addEventListener('click', () => {
    if (qtyInput) qtyInput.value = String(parseInt(qtyInput.value, 10) + 1);
  });
</script>
