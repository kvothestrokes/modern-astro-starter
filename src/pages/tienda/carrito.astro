---
import CatalogLayout from '../../layouts/CatalogLayout.astro';

export const prerender = false;
---

<CatalogLayout title="Tu carrito | Tienda">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <nav class="mb-6 text-sm text-zinc-500" aria-label="Breadcrumb">
      <a href="/tienda" class="hover:text-zinc-700">Tienda</a>
      <span class="mx-1">/</span>
      <span>Tu carrito</span>
    </nav>

    <h1 class="text-2xl font-semibold text-zinc-900">Resumen de tu pedido</h1>
    <p class="mt-1 text-sm text-zinc-500">Revisa los productos antes de continuar al checkout.</p>

    <!-- Contenedor de ítems (se rellena en cliente) -->
    <div id="carrito-preview-root" class="mt-6">
      <!-- Estado vacío (oculto si hay ítems) -->
      <div id="carrito-empty" class="rounded-xl border border-zinc-200 bg-white p-8 text-center">
        <p class="font-medium text-zinc-700">Tu carrito está vacío</p>
        <p class="mt-1 text-sm text-zinc-500">Agrega productos desde la tienda para ver aquí tu pedido.</p>
        <a
          href="/tienda"
          class="mt-4 inline-block rounded-lg bg-catalog-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-catalog-600"
        >
          Ir a la tienda
        </a>
      </div>

      <!-- Lista de ítems (oculta hasta que el script la rellene) -->
      <div id="carrito-items-wrap" class="hidden">
        <ul id="carrito-items-list" class="divide-y divide-zinc-100 rounded-xl border border-zinc-200 bg-white">
          <!-- Items inyectados por script -->
        </ul>
        <div class="mt-6 rounded-xl border border-zinc-200 bg-white p-4">
          <div class="flex justify-between text-base font-medium text-zinc-900">
            <span>Subtotal</span>
            <span id="carrito-subtotal">$0.00</span>
          </div>
          <p class="mt-1 text-xs text-zinc-500">Los impuestos y envío se calcularán en el checkout.</p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-between">
            <a
              href="/tienda"
              class="order-2 sm:order-1 rounded-lg border border-zinc-300 bg-white px-4 py-2.5 text-center text-sm font-medium text-zinc-700 hover:bg-zinc-50"
            >
              Seguir comprando
            </a>
            <button
              type="button"
              id="carrito-checkout-btn"
              class="order-1 sm:order-2 w-full rounded-lg bg-catalog-500 py-2.5 text-sm font-medium text-white hover:bg-catalog-600 focus:outline-none focus:ring-2 focus:ring-catalog-500 sm:w-auto sm:min-w-[180px]"
            >
              Hacer pedido
            </button>
          </div>
          <p id="carrito-checkout-feedback" class="mt-3 min-h-[1.25rem] text-center text-sm text-red-600" aria-live="polite"></p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { getItems, getSubtotal, removeItem, setQuantity } from '../../lib/catalog/cartStore';
    import { createOrderFromCart } from '../../lib/catalog/createOrderFromCart';

    const emptyEl = document.getElementById('carrito-empty');
    const wrapEl = document.getElementById('carrito-items-wrap');
    const listEl = document.getElementById('carrito-items-list');
    const subtotalEl = document.getElementById('carrito-subtotal');
    const checkoutBtn = document.getElementById('carrito-checkout-btn');
    const checkoutFeedback = document.getElementById('carrito-checkout-feedback');

    function formatMoney(n: number) {
      return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(n);
    }

    function escapeHtml(str: string) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function render() {
      const items = getItems();
      if (!listEl || !emptyEl || !wrapEl) return;

      if (items.length === 0) {
        emptyEl.classList.remove('hidden');
        wrapEl.classList.add('hidden');
        if (subtotalEl) subtotalEl.textContent = formatMoney(0);
        return;
      }

      emptyEl.classList.add('hidden');
      wrapEl.classList.remove('hidden');

      listEl.innerHTML = items
        .map((item) => {
          const price = item.sale_price != null ? item.sale_price : item.price;
          const lineTotal = price * item.quantity;
          const variantParts = [];
          if (item.size) variantParts.push(`Talla: ${item.size}`);
          if (item.color) variantParts.push(`Color: ${item.color}`);
          const variantText =
            variantParts.length > 0 ? variantParts.join(', ') : `${item.variant.label}: ${item.variant.value}`;
          return `
          <li class="carrito-preview-item flex gap-4 p-4" data-item-id="${item.id}">
            <img
              src="${item.imageUrl || ''}"
              alt=""
              class="h-24 w-24 shrink-0 rounded-lg bg-zinc-100 object-cover"
            />
            <div class="min-w-0 flex-1">
              <p class="font-medium text-zinc-900">${escapeHtml(item.name)}</p>
              <p class="text-sm text-zinc-500">${escapeHtml(variantText)}</p>
              <p class="mt-1 text-sm text-zinc-600">${formatMoney(price)} c/u</p>
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <div class="flex items-center rounded border border-zinc-200 bg-zinc-50">
                  <button
                    type="button"
                    class="carrito-qty-decrease h-7 w-7 flex items-center justify-center rounded-l text-zinc-600 hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-catalog-500"
                    data-item-id="${item.id}"
                    aria-label="Disminuir cantidad"
                  >−</button>
                  <span class="carrito-qty-value min-w-[1.5rem] text-center text-sm font-medium text-zinc-900" aria-live="polite">${item.quantity}</span>
                  <button
                    type="button"
                    class="carrito-qty-increase h-7 w-7 flex items-center justify-center rounded-r text-zinc-600 hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-catalog-500"
                    data-item-id="${item.id}"
                    aria-label="Aumentar cantidad"
                  >+</button>
                </div>
                <button
                  type="button"
                  class="carrito-item-remove text-xs text-red-600 hover:underline"
                  data-item-id="${item.id}"
                >
                  Quitar
                </button>
              </div>
            </div>
            <div class="text-right">
              <p class="font-medium text-zinc-900">${formatMoney(lineTotal)}</p>
            </div>
          </li>
        `;
        })
        .join('');

      if (subtotalEl) subtotalEl.textContent = formatMoney(getSubtotal());

      listEl.querySelectorAll('.carrito-item-remove').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).getAttribute('data-item-id');
          if (id) removeItem(id);
          render();
          window.dispatchEvent(new CustomEvent('catalog-cart-update'));
        });
      });

      listEl.querySelectorAll('.carrito-qty-decrease').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).getAttribute('data-item-id');
          if (!id) return;
          const current = getItems().find((i) => i.id === id)?.quantity ?? 1;
          setQuantity(id, Math.max(1, current - 1));
          render();
          window.dispatchEvent(new CustomEvent('catalog-cart-update'));
        });
      });
      listEl.querySelectorAll('.carrito-qty-increase').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).getAttribute('data-item-id');
          if (!id) return;
          const current = getItems().find((i) => i.id === id)?.quantity ?? 0;
          setQuantity(id, Math.min(99, current + 1));
          render();
          window.dispatchEvent(new CustomEvent('catalog-cart-update'));
        });
      });
    }

    checkoutBtn?.addEventListener('click', async () => {
      if (getItems().length === 0) return;
      if (checkoutFeedback) checkoutFeedback.textContent = '';
      if (checkoutBtn) (checkoutBtn as HTMLButtonElement).disabled = true;
      try {
        await createOrderFromCart();
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        if (checkoutFeedback) checkoutFeedback.textContent = msg;
        if (checkoutBtn) (checkoutBtn as HTMLButtonElement).disabled = false;
      }
    });

    window.addEventListener('catalog-cart-update', render);
    render();
  </script>
</CatalogLayout>
